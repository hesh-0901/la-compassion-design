rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myAdminRecord() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && myAdminRecord().data.active == true
        && myAdminRecord().data.role in ['admin', 'superAdmin'];
    }

    function isSuperAdmin() {
      return isActiveAdmin() && myAdminRecord().data.role == 'superAdmin';
    }

    function validCloudinaryUrl(value) {
      return value is string
        && (value == ''
          || value.matches('https://res\\.cloudinary\\.com/ocgef9bk/(image|raw)/upload/.*'));
    }

    function validAuditAppend() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['statusHistory'])
        || (request.resource.data.statusHistory is list
          && request.resource.data.statusHistory.size() == resource.data.get('statusHistory', []).size() + 1
          && request.resource.data.statusHistory[request.resource.data.statusHistory.size() - 1].adminId == request.auth.uid
          && request.resource.data.statusHistory[request.resource.data.statusHistory.size() - 1].to == request.resource.data.status
          && request.resource.data.statusHistory[request.resource.data.statusHistory.size() - 1].changedAt is timestamp);
    }

    function validInternalNote() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['internalNote'])
        || (request.resource.data.internalNote is string && request.resource.data.internalNote.size() <= 2000);
    }

    function validPublicApplication() {
      return request.resource.data.keys().hasOnly([
        'fullName', 'gender', 'phone', 'email', 'area', 'age',
        'member', 'extension', 'attendance', 'department', 'maturity',
        'level', 'tools', 'portfolio', 'portfolioFileUrl', 'portfolioPublicId',
        'profilePhotoUrl', 'profilePhotoPublicId', 'ram', 'availability',
        'motivation', 'commitment', 'status', 'createdAt'
      ])
      && request.resource.data.keys().hasAll([
        'fullName', 'gender', 'phone', 'email', 'area', 'age',
        'member', 'extension', 'attendance', 'department', 'maturity',
        'level', 'tools', 'portfolio', 'portfolioFileUrl', 'portfolioPublicId',
        'profilePhotoUrl', 'profilePhotoPublicId', 'ram', 'availability',
        'motivation', 'commitment', 'status', 'createdAt'
      ])
      && request.resource.data.fullName is string
      && request.resource.data.fullName.size() >= 2
      && request.resource.data.fullName.size() <= 100
      && request.resource.data.gender in ['Homme', 'Femme']
      && request.resource.data.phone is string
      && request.resource.data.phone.matches('^\\+243[0-9]{9}$')
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 160
      && request.resource.data.area is string
      && request.resource.data.area.size() <= 120
      && request.resource.data.age is string
      && request.resource.data.member == 'Oui'
      && request.resource.data.extension is string
      && request.resource.data.attendance is string
      && request.resource.data.department is string
      && request.resource.data.maturity is string
      && request.resource.data.level in ['Débutant', 'Intermédiaire', 'Avancé']
      && request.resource.data.tools is list
      && request.resource.data.tools.size() <= 5
      && request.resource.data.portfolio is string
      && request.resource.data.portfolio.size() <= 2048
      && validCloudinaryUrl(request.resource.data.portfolioFileUrl)
      && request.resource.data.portfolioPublicId is string
      && request.resource.data.profilePhotoUrl is string
      && request.resource.data.profilePhotoUrl.matches('https://res\\.cloudinary\\.com/ocgef9bk/image/upload/.*')
      && request.resource.data.profilePhotoPublicId is string
      && request.resource.data.ram in ['Oui', 'Non', 'Je ne sais pas']
      && request.resource.data.availability in ['Oui', 'Partiellement']
      && request.resource.data.motivation is string
      && request.resource.data.motivation.size() <= 160
      && request.resource.data.commitment == true
      && request.resource.data.status == 'received'
      && request.resource.data.createdAt == request.time;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /candidatures/{candidateId} {
      allow create: if validPublicApplication();
      allow get, list: if isActiveAdmin();

      allow update: if isActiveAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'statusHistory', 'internalNote'])
        && validAuditAppend() && validInternalNote();

      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'reviewedAt', 'reviewedBy', 'statusHistory', 'internalNote',
            'fullName', 'name', 'phone', 'email', 'area', 'commune',
            'assembly', 'extension', 'level', 'ram'
          ])
        && validAuditAppend() && validInternalNote();

      allow delete: if isSuperAdmin();
    }

    match /configuration/{configId} {
      allow read: if isActiveAdmin();
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}